# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- Core ---
NODE_ENV=development
PORT=8000
DATABASE_URI=postgresql://USER:PASSWORD@localhost:5432/Talent-Grid

# Required when NODE_ENV=test. Hard safety guard: it must differ from
# DATABASE_URI and its database name must contain "test", so the test suite
# can never touch the development database.
TEST_DATABASE_URI=postgresql://USER:PASSWORD@localhost:5432/talentgrid_test

# --- Auth ---
# Minimum 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Optional. When omitted it is derived from JWT_SECRET via HKDF.
# CSRF_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
SESSION_TTL_DAYS=30
# Seconds a repeated refresh attempt is tolerated right after rotation
# (covers concurrent tabs/requests racing one rotation).
REFRESH_REUSE_GRACE_SECONDS=30

# --- Cookies & CORS ---
# COOKIE_SECURE defaults to true in production, false otherwise.
# COOKIE_SECURE=true
# COOKIE_SAMESITE=lax            # lax | strict | none; "none" requires COOKIE_SECURE=true
# COOKIE_DOMAIN=
# Comma-separated browser origins. Must be set explicitly in production.
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Mailer / OTP ---
# console = OTP codes are printed to the server log (development only;
#           rejected in production).
# test    = in-memory outbox used by the test suite.
# smtp    = placeholder, not implemented yet (requests fail with 503).
MAILER=console
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5

# --- Misc ---
BCRYPT_ROUNDS=12
# Shared secret for the assessment engine to call
# POST /api/v1/assessments/attempts/:attemptId/evaluate.
# ASSESSMENT_ENGINE_TOKEN=
# true | false | hop count. Set when running behind a reverse proxy.
# TRUST_PROXY=false
