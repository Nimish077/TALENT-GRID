// TalentGrid database schema.
//
// Source of truth: server/DatabaseSchema.png (28 tables). This file preserves the
// image's table names, column names and column types verbatim. Prisma field names
// intentionally stay snake_case so the schema can be diffed against the image.
//
// INFERRED (not shown in the image, documented in README.md):
//   - uniqueness constraints, nullability, numeric precision, defaults, cascades
//   - CHECK constraints and partial unique indexes are added via SQL in the
//     initial migration (Prisma cannot express them declaratively)
//
// AUTHORIZED EXTENSION (not present in the image, user-approved): `sessions`
//   for cookie-based refresh-token session management.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Identity & Access
// ---------------------------------------------------------------------------

model User {
  id                String    @id @default(uuid()) @db.Uuid
  email             String    @unique
  password_hash     String
  full_name         String
  phone             String?
  avatar_url        String?
  role              String
  status            String    @default("active")
  email_verified_at DateTime?
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  candidate_profile       CandidateProfile?
  sessions                Session[]
  organization_users      OrganizationUser[]
  institution_users       InstitutionUser[]
  institution_memberships InstitutionMembership[]
  membership_claims       InstitutionMembershipClaim[]
  imports_uploaded        InstitutionImport[]
  jobs_created            Job[]                        @relation("JobCreatedBy")
  drives_created          PlacementDrive[]             @relation("DriveCreatedBy")
  applications_invited    JobApplication[]             @relation("ApplicationInvitedBy")

  @@map("users")
}

// ---------------------------------------------------------------------------
// Institutions
// ---------------------------------------------------------------------------

model Institution {
  id         String   @id @default(uuid()) @db.Uuid
  name       String
  code       String   @unique
  website    String?
  email      String?
  phone      String?
  address    String?  @db.Text
  city       String?
  state      String?
  country    String?
  status     String   @default("pending")
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  users       InstitutionUser[]
  imports     InstitutionImport[]
  memberships InstitutionMembership[]
  drives      PlacementDrive[]
  educations  CandidateEducation[]

  @@map("institutions")
}

model InstitutionUser {
  id             String      @id @default(uuid()) @db.Uuid
  institution_id String      @db.Uuid
  user_id        String      @db.Uuid
  role           String
  status         String      @default("pending")
  created_at     DateTime    @default(now())
  updated_at     DateTime    @updatedAt
  institution    Institution @relation(fields: [institution_id], references: [id], onDelete: Cascade)
  user           User        @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([institution_id, user_id])
  @@map("institution_users")
}

model InstitutionImport {
  id                  String                  @id @default(uuid()) @db.Uuid
  institution_id      String                  @db.Uuid
  file_url            String?
  file_name           String?
  status              String                  @default("processing")
  total_rows          Int                     @default(0)
  successful_rows     Int                     @default(0)
  failed_rows         Int                     @default(0)
  created_at          DateTime                @default(now())
  completed_at        DateTime?
  uploaded_by_user_id String                  @db.Uuid
  institution         Institution             @relation(fields: [institution_id], references: [id], onDelete: Cascade)
  uploaded_by         User                    @relation(fields: [uploaded_by_user_id], references: [id], onDelete: Restrict)
  memberships         InstitutionMembership[]

  @@map("institution_imports")
}

// ---------------------------------------------------------------------------
// Memberships & Claims
// ---------------------------------------------------------------------------

model InstitutionMembership {
  id                  String                       @id @default(uuid()) @db.Uuid
  enrollment_id       String
  full_name           String
  institutional_email String?
  personal_email      String?
  phone               String?
  department          String?
  program             String?
  batch               String?
  graduation_year     Int?
  current_semester    Int?
  cgpa                Decimal?                     @db.Decimal(4, 2)
  backlog_count       Int?
  membership_status   String                       @default("active")
  verification_status String                       @default("unverified")
  verification_source String?
  joined_at           DateTime?
  verified_at         DateTime?
  created_at          DateTime                     @default(now())
  updated_at          DateTime                     @updatedAt
  institution_id      String                       @db.Uuid
  import_id           String?                      @db.Uuid
  user_id             String?                      @db.Uuid
  institution         Institution                  @relation(fields: [institution_id], references: [id], onDelete: Restrict)
  import              InstitutionImport?           @relation(fields: [import_id], references: [id], onDelete: SetNull)
  user                User?                        @relation(fields: [user_id], references: [id], onDelete: SetNull)
  claims              InstitutionMembershipClaim[]

  @@unique([institution_id, enrollment_id])
  @@index([institution_id, membership_status])
  @@map("institution_memberships")
}

model InstitutionMembershipClaim {
  id                        String                @id @default(uuid()) @db.Uuid
  institution_membership_id String                @db.Uuid
  requested_email           String
  otp_hash                  String
  otp_expires_at            DateTime
  otp_attempts              Int                   @default(0)
  status                    String                @default("pending")
  verified_at               DateTime?
  created_at                DateTime              @default(now())
  user_id                   String?               @db.Uuid
  membership                InstitutionMembership @relation(fields: [institution_membership_id], references: [id], onDelete: Cascade)
  user                      User?                 @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@map("institution_membership_claims")
}

// ---------------------------------------------------------------------------
// Candidate & Skills
// ---------------------------------------------------------------------------

model CandidateProfile {
  id                 String   @id @default(uuid()) @db.Uuid
  user_id            String   @unique @db.Uuid
  headline           String?
  bio                String?  @db.Text
  profile_photo_url  String?
  location           String?
  github_url         String?
  linkedin_url       String?
  portfolio_url      String?
  resume_url         String?
  profile_visibility String   @default("public")
  open_to_work       Boolean  @default(true)
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt
  user               User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  educations          CandidateEducation[]
  projects            CandidateProject[]
  experiences         CandidateExperience[]
  certifications      CandidateCertification[]
  skills              CandidateSkill[]
  consents            CandidateConsent[]
  applications        JobApplication[]
  drive_applications  PlacementDriveCandidate[]
  assessment_attempts AssessmentAttempt[]

  @@map("candidate_profiles")
}

model CandidateEducation {
  id                   String           @id @default(uuid()) @db.Uuid
  institution_id       String?          @db.Uuid
  institution_name     String
  degree               String
  field_of_study       String?
  start_year           Int
  end_year             Int?
  verification_status  String           @default("unverified")
  created_at           DateTime         @default(now())
  updated_at           DateTime         @updatedAt
  candidate_profile_id String           @db.Uuid
  institution          Institution?     @relation(fields: [institution_id], references: [id], onDelete: SetNull)
  candidate_profile    CandidateProfile @relation(fields: [candidate_profile_id], references: [id], onDelete: Cascade)

  @@map("candidate_educations")
}

model CandidateProject {
  id                   String           @id @default(uuid()) @db.Uuid
  title                String
  description          String?          @db.Text
  project_url          String?
  github_url           String?
  start_date           DateTime?        @db.Date
  end_date             DateTime?        @db.Date
  created_at           DateTime         @default(now())
  updated_at           DateTime         @updatedAt
  candidate_profile_id String           @db.Uuid
  candidate_profile    CandidateProfile @relation(fields: [candidate_profile_id], references: [id], onDelete: Cascade)

  @@map("candidate_projects")
}

model CandidateExperience {
  id                   String           @id @default(uuid()) @db.Uuid
  organization_name    String
  job_title            String
  description          String?          @db.Text
  start_date           DateTime?        @db.Date
  end_date             DateTime?        @db.Date
  is_current           Boolean          @default(false)
  created_at           DateTime         @default(now())
  updated_at           DateTime         @updatedAt
  candidate_profile_id String           @db.Uuid
  candidate_profile    CandidateProfile @relation(fields: [candidate_profile_id], references: [id], onDelete: Cascade)

  @@map("candidate_experiences")
}

model CandidateCertification {
  id                   String           @id @default(uuid()) @db.Uuid
  name                 String
  issuing_organization String?
  credential_id        String?
  credential_url       String?
  issue_date           DateTime?        @db.Date
  expiry_date          DateTime?        @db.Date
  created_at           DateTime         @default(now())
  candidate_profile_id String           @db.Uuid
  candidate_profile    CandidateProfile @relation(fields: [candidate_profile_id], references: [id], onDelete: Cascade)

  @@map("candidate_certifications")
}

model Skill {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  category    String?
  description String?  @db.Text
  status      String   @default("active")
  created_at  DateTime @default(now())

  candidate_skills  CandidateSkill[]
  job_skills        JobSkill[]
  assessment_skills AssessmentSkill[]

  @@map("skills")
}

model CandidateSkill {
  id                   String           @id @default(uuid()) @db.Uuid
  candidate_profile_id String           @db.Uuid
  declared_level       String
  verification_status  String           @default("unverified")
  verified_level       String?
  verified_at          DateTime?
  created_at           DateTime         @default(now())
  updated_at           DateTime         @updatedAt
  skill_id             String           @db.Uuid
  candidate_profile    CandidateProfile @relation(fields: [candidate_profile_id], references: [id], onDelete: Cascade)
  skill                Skill            @relation(fields: [skill_id], references: [id], onDelete: Restrict)

  @@unique([candidate_profile_id, skill_id])
  @@index([skill_id, verification_status, verified_level])
  @@map("candidate_skills")
}

model CandidateConsent {
  id                   String           @id @default(uuid()) @db.Uuid
  candidate_profile_id String           @db.Uuid
  consent_type         String
  granted              Boolean          @default(false)
  policy_version       String
  granted_at           DateTime?
  revoked_at           DateTime?
  created_at           DateTime         @default(now())
  candidate_profile    CandidateProfile @relation(fields: [candidate_profile_id], references: [id], onDelete: Cascade)

  @@unique([candidate_profile_id, consent_type])
  @@map("candidate_consents")
}

// ---------------------------------------------------------------------------
// Assessments
// ---------------------------------------------------------------------------

model Assessment {
  id               String   @id @default(uuid()) @db.Uuid
  title            String
  description      String?  @db.Text
  assessment_type  String
  difficulty       String   @default("beginner")
  duration_minutes Int
  version          Int      @default(1)
  status           String   @default("draft")
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  skills            AssessmentSkill[]
  attempts          AssessmentAttempt[]
  job_assessments   JobAssessment[]
  drive_assessments PlacementDriveAssessment[]

  @@map("assessments")
}

model AssessmentSkill {
  id            String     @id @default(uuid()) @db.Uuid
  skill_id      String     @db.Uuid
  assessment_id String     @db.Uuid
  target_level  String
  created_at    DateTime   @default(now())
  skill         Skill      @relation(fields: [skill_id], references: [id], onDelete: Cascade)
  assessment    Assessment @relation(fields: [assessment_id], references: [id], onDelete: Cascade)

  @@unique([assessment_id, skill_id])
  @@map("assessment_skills")
}

model AssessmentAttempt {
  id                           String                   @id @default(uuid()) @db.Uuid
  candidate_profile_id         String                   @db.Uuid
  placement_drive_candidate_id String?                  @db.Uuid
  attempt_number               Int
  score                        Decimal?                 @db.Decimal(5, 2)
  level                        String?
  result_status                String                   @default("pending")
  started_at                   DateTime                 @default(now())
  submitted_at                 DateTime?
  evaluated_at                 DateTime?
  created_at                   DateTime                 @default(now())
  job_application_id           String?                  @db.Uuid
  assessment_id                String                   @db.Uuid
  candidate_profile            CandidateProfile         @relation(fields: [candidate_profile_id], references: [id], onDelete: Cascade)
  placement_drive_candidate    PlacementDriveCandidate? @relation(fields: [placement_drive_candidate_id], references: [id], onDelete: SetNull)
  job_application              JobApplication?          @relation(fields: [job_application_id], references: [id], onDelete: SetNull)
  assessment                   Assessment               @relation(fields: [assessment_id], references: [id], onDelete: Restrict)

  @@unique([assessment_id, candidate_profile_id, attempt_number])
  @@map("assessment_attempts")
}

// ---------------------------------------------------------------------------
// Jobs & Recruitment
// ---------------------------------------------------------------------------

model Organization {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  industry    String?
  website     String?
  email       String?
  phone       String?
  description String?  @db.Text
  logo_url    String?
  location    String?
  status      String   @default("pending")
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  users OrganizationUser[]
  jobs  Job[]

  @@map("organizations")
}

model OrganizationUser {
  id              String       @id @default(uuid()) @db.Uuid
  user_id         String       @db.Uuid
  organization_id String       @db.Uuid
  role            String
  status          String       @default("pending")
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt
  user            User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  organization    Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@unique([organization_id, user_id])
  @@map("organization_users")
}

model Job {
  id                   String       @id @default(uuid()) @db.Uuid
  created_by_user_id   String       @db.Uuid
  title                String
  description          String?      @db.Text
  location             String?
  work_mode            String?
  employment_type      String?
  experience_level     String?
  salary_min           Decimal?     @db.Decimal(12, 2)
  salary_max           Decimal?     @db.Decimal(12, 2)
  application_deadline DateTime?
  status               String       @default("draft")
  published_at         DateTime?
  created_at           DateTime     @default(now())
  updated_at           DateTime     @updatedAt
  organization_id      String       @db.Uuid
  created_by           User         @relation("JobCreatedBy", fields: [created_by_user_id], references: [id], onDelete: Restrict)
  organization         Organization @relation(fields: [organization_id], references: [id], onDelete: Restrict)

  skills       JobSkill[]
  assessments  JobAssessment[]
  applications JobApplication[]
  drive_jobs   PlacementDriveJob[]

  @@index([status, published_at])
  @@map("jobs")
}

model JobSkill {
  id             String   @id @default(uuid()) @db.Uuid
  job_id         String   @db.Uuid
  required_level String
  is_required    Boolean  @default(true)
  created_at     DateTime @default(now())
  skill_id       String   @db.Uuid
  job            Job      @relation(fields: [job_id], references: [id], onDelete: Cascade)
  skill          Skill    @relation(fields: [skill_id], references: [id], onDelete: Restrict)

  @@unique([job_id, skill_id])
  @@map("job_skills")
}

model JobAssessment {
  id            String     @id @default(uuid()) @db.Uuid
  job_id        String     @db.Uuid
  is_required   Boolean    @default(false)
  created_at    DateTime   @default(now())
  assessment_id String     @db.Uuid
  job           Job        @relation(fields: [job_id], references: [id], onDelete: Cascade)
  assessment    Assessment @relation(fields: [assessment_id], references: [id], onDelete: Restrict)

  @@unique([job_id, assessment_id])
  @@map("job_assessments")
}

model JobApplication {
  id                   String              @id @default(uuid()) @db.Uuid
  candidate_profile_id String              @db.Uuid
  invited_by_user_id   String?             @db.Uuid
  source               String
  status               String              @default("applied")
  resume_url           String?
  cover_note           String?             @db.Text
  applied_at           DateTime            @default(now())
  updated_at           DateTime            @updatedAt
  job_id               String              @db.Uuid
  candidate_profile    CandidateProfile    @relation(fields: [candidate_profile_id], references: [id], onDelete: Cascade)
  invited_by           User?               @relation("ApplicationInvitedBy", fields: [invited_by_user_id], references: [id], onDelete: SetNull)
  job                  Job                 @relation(fields: [job_id], references: [id], onDelete: Restrict)
  assessment_attempts  AssessmentAttempt[]

  @@unique([job_id, candidate_profile_id])
  @@index([job_id, status])
  @@map("job_applications")
}

// ---------------------------------------------------------------------------
// Campus Placements
// ---------------------------------------------------------------------------

model PlacementDrive {
  id                   String      @id @default(uuid()) @db.Uuid
  institution_id       String      @db.Uuid
  created_by_user_id   String      @db.Uuid
  title                String
  description          String?     @db.Text
  status               String      @default("draft")
  application_open_at  DateTime?
  application_deadline DateTime?
  min_cgpa             Decimal?    @db.Decimal(4, 2)
  max_backlogs         Int?
  eligible_batch       String?
  eligibility_notes    String?     @db.Text
  created_at           DateTime    @default(now())
  updated_at           DateTime    @updatedAt
  institution          Institution @relation(fields: [institution_id], references: [id], onDelete: Restrict)
  created_by           User        @relation("DriveCreatedBy", fields: [created_by_user_id], references: [id], onDelete: Restrict)

  departments PlacementDriveDepartment[]
  candidates  PlacementDriveCandidate[]
  jobs        PlacementDriveJob[]
  assessments PlacementDriveAssessment[]

  @@map("placement_drives")
}

model PlacementDriveCandidate {
  id                   String              @id @default(uuid()) @db.Uuid
  candidate_profile_id String              @db.Uuid
  status               String              @default("applied")
  eligibility_status   String
  applied_at           DateTime            @default(now())
  shortlisted_at       DateTime?
  selected_at          DateTime?
  placement_drive_id   String              @db.Uuid
  created_at           DateTime            @default(now())
  updated_at           DateTime            @updatedAt
  candidate_profile    CandidateProfile    @relation(fields: [candidate_profile_id], references: [id], onDelete: Cascade)
  placement_drive      PlacementDrive      @relation(fields: [placement_drive_id], references: [id], onDelete: Cascade)
  assessment_attempts  AssessmentAttempt[]

  @@unique([placement_drive_id, candidate_profile_id])
  @@index([placement_drive_id, status])
  @@map("placement_drive_candidates")
}

model PlacementDriveDepartment {
  id                 String         @id @default(uuid()) @db.Uuid
  placement_drive_id String         @db.Uuid
  department_name    String
  created_at         DateTime       @default(now())
  placement_drive    PlacementDrive @relation(fields: [placement_drive_id], references: [id], onDelete: Cascade)

  @@unique([placement_drive_id, department_name])
  @@map("placement_drive_departments")
}

model PlacementDriveJob {
  id                 String         @id @default(uuid()) @db.Uuid
  placement_drive_id String         @db.Uuid
  job_id             String         @db.Uuid
  created_at         DateTime       @default(now())
  placement_drive    PlacementDrive @relation(fields: [placement_drive_id], references: [id], onDelete: Cascade)
  job                Job            @relation(fields: [job_id], references: [id], onDelete: Cascade)

  @@unique([placement_drive_id, job_id])
  @@map("placement_drive_jobs")
}

model PlacementDriveAssessment {
  id                 String         @id @default(uuid()) @db.Uuid
  placement_drive_id String         @db.Uuid
  is_required        Boolean        @default(false)
  created_at         DateTime       @default(now())
  assessment_id      String         @db.Uuid
  placement_drive    PlacementDrive @relation(fields: [placement_drive_id], references: [id], onDelete: Cascade)
  assessment         Assessment     @relation(fields: [assessment_id], references: [id], onDelete: Restrict)

  @@unique([placement_drive_id, assessment_id])
  @@map("placement_drive_assessments")
}

// ---------------------------------------------------------------------------
// Consent & Security
// ---------------------------------------------------------------------------

// AUTHORIZED EXTENSION — not part of DatabaseSchema.png (user-approved for
// cookie-based authentication with rotating refresh tokens).
model Session {
  id                 String    @id @default(uuid()) @db.Uuid
  user_id            String    @db.Uuid
  family_id          String    @db.Uuid
  refresh_token_hash String    @unique
  user_agent         String?
  ip_address         String?
  expires_at         DateTime
  revoked_at         DateTime?
  revoke_reason      String?
  created_at         DateTime  @default(now())
  user               User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([family_id])
  @@map("sessions")
}
