# Optional. Defaults to "/api/v1" (Vite proxies /api to http://localhost:8000).
# Set this when the API is on a different origin, e.g.:
# VITE_API_BASE_URL=http://localhost:8000/api/v1

# Demo accounts panel on the login pages (one-click sign-in with the public demo
# accounts from `npm run db:seed-demo`). OFF unless this is exactly "true".
# It is baked in at build time: on Vercel set it and redeploy; locally put it in
# .env.local and restart `npm run dev`. Keep it off for a real deployment.
# VITE_DEMO_LOGIN=true
